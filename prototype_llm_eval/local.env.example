# Copy to local.env (same folder). File is gitignored — never commit secrets.
#
#   copy prototype_llm_eval\local.env.example prototype_llm_eval\local.env
#
# One KEY=value per line. Quotes optional. Lines starting with # are ignored.
#
# =============================================================================
# PROTOTYPE WEB LOGIN (NOT production auth — dissertation demo gate only)
# =============================================================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-demo-password
# SESSION_SECRET=long-random-string-for-signed-session-cookie
#
# If ADMIN_PASSWORD is omitted, the server uses insecure default "codequest-demo"
# and prints a warning. Plaintext compare only; no hashing or user database.
#
# =============================================================================
# A) GEMINI API-KEY MODE (default for provider "gemini")
# =============================================================================
# The app uses google.generativeai + API key (Generative Language API).
# NOT Vertex AI, NOT service-account JSON, NOT OAuth.
# Prefer a key from Google AI Studio. Cloud Console keys must allow
# "Generative Language API" (or "Don't restrict key" for local dev).
#
# Test:  python prototype_llm_eval/scripts/test_gemini_key.py
# =============================================================================
# GEMINI_API_KEY=paste_your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# --- Ollama (Llama and optional local Mistral) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
# MISTRAL_OLLAMA_MODEL=mistral

# --- Mistral API (when MistralProvider uses the cloud API; if empty, Mistral falls back to Ollama model above) ---
# MISTRAL_API_KEY=paste_your_key_here
# MISTRAL_MODEL=mistral-small-latest

# =============================================================================
# B) LOCAL FALLBACK — live QUESTION generation without Gemini (explicit only)
# =============================================================================
# No silent fallback: you must set QUESTION_GENERATION_PROVIDER=llama and run Ollama.
# For a fully local /demo-ui, also set MARKING_PROVIDER and FEEDBACK_PROVIDER to llama.
# QUESTION_GENERATION_PROVIDER=gemini
# QUESTION_GENERATION_PROVIDER=llama

# --- Optional server / batch behaviour ---
# USE_FIXED_DATASET=false
# MARKING_PROVIDER=gemini
# FEEDBACK_PROVIDER=gemini
# MARKING_MODELS=gemini,llama,mistral
# FEEDBACK_MODELS=gemini,llama,mistral
